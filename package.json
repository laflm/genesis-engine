{
  "name": "genesis-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GENESIS Engine — suite d'outils pour MODIFIER des jeux existants (v1 : Sprite Editor pour Black Boy Go!)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build:local": "node scripts/build-local.mjs",
    "bot": "python3 tests/bot/e2e.py",
    "extract:items": "node scripts/extract-items.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
